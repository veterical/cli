{
  "name": "veterical",
  "version": "1.1.0",
  "private": false,
  "description": "Veterical CLI — manage the clients, patients, appointments, invoices, payments and vaccinations of your veterinary clinic from the terminal",
  "license": "Apache-2.0",
  "repository": "github:veterical/cli",
  "homepage": "https://www.veterical.com/",
  "author": "Veterical",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "bin": {
    "veterical": "./bin/veterical.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "develop": "node index.js",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --access public",
    "publish:repo": "node scripts/publishCli.mjs",
    "test": "vitest run",
    "test:smoke": "node scripts/build.js && node --check dist/index.js && node dist/index.js --version"
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "keywords": [
    "veterinary",
    "clinic",
    "appointments",
    "patients",
    "vaccinations",
    "cli"
  ],
  "dependencies": {
    "commander": "8.3.0",
    "inquirer": "8.2.5",
    "node-localstorage": "2.2.1"
  },
  "devDependencies": {
    "@monorepool/agentfirst": "0.0.0",
    "@monorepool/root": "0.0.0",
    "esbuild": "0.25.4",
    "vitest": "catalog:"
  }
}
